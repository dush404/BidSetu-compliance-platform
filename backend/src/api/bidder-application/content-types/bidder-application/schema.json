{
  "kind": "collectionType",
  "collectionName": "bidder_applications",
  "info": {
    "singularName": "bidder-application",
    "pluralName": "bidder-applications",
    "displayName": "Bidder Application"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "tender": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tender.tender",
      "inversedBy": "bidderApplications"
    },
    "bidderName": { "type": "string" },
    "companyName": { "type": "string" },
    "gstin": { "type": "string" },
    "panNumber": { "type": "string" },
    "udyamId": { "type": "string" },
    "epfoCode": { "type": "string" },
    "esicCode": { "type": "string" },
    "dpiitNumber": { "type": "string" },
    "nsicNumber": { "type": "string" },
    "documents": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "verificationStatus": {
      "type": "enumeration",
      "enum": ["Pending", "Processing", "Verified", "Rejected", "Manual Review"],
      "default": "Pending"
    },
    "complianceScore": { "type": "decimal" },
    "riskLevel": {
      "type": "enumeration",
      "enum": ["Low", "Medium", "High", "Critical"]
    },
    "aiRecommendation": { "type": "text" },
    "verificationResult": { "type": "json" },
    "extractedData": { "type": "json" },
    "lastVerifiedAt": { "type": "datetime" },
    "verificationlog": { "type": "json" }
  }
}
